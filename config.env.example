# Copy to .env and fill in secrets:
#   cp config.env.example .env
#
# Python mediation demo reads OPENAI_* variables.
# Node server (npm start) reads INWORLD_* and PORT.

# --- OpenAI (mediation tree demo) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=512
OPENAI_TEMPERATURE=0.7

# --- Inworld (Node voice/chat server) ---
INWORLD_API_KEY=
INWORLD_MODEL=openai/gpt-4o-mini
INWORLD_STT_MODEL=inworld/inworld-stt-1

# --- Tree-guided live mediator (Python sidecar) ---
# Pick a case folder (uses live/cases/<name>/simulated_conversation_tree.json):
MEDIATION_CASE=case1
# Or point directly at a tree file:
# MEDIATION_TREE_PATH=live/cases/case1/simulated_conversation_tree.json
MEDIATOR_PORT=3001
MEDIATOR_API_URL=http://127.0.0.1:3001
USE_TREE_MEDIATOR=1
MEDIATOR_DRY_RUN=0

# --- Mediator pacing ---
# Post-intro speaking turns before a forced wrap-up (0 = no turn limit; session ends
# only on CLOSE: when a resolution is reached)
MEDIATOR_WRAP_TURNS=0

# --- Server ---
PORT=3000
